###############################################################################
# Application
###############################################################################
APP_NAME=FlightApi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

###############################################################################
# API Authentication
#
# The shared secret clients must send in the `Api-Key` header. The
# EnsureApiKeyIsValid middleware validates against this value. Generate a strong
# random value for any non-local environment.
###############################################################################
API_KEY=123456789

###############################################################################
# Logging
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

###############################################################################
# Database (MySQL via Sail by default)
#
# Sail provisions a MySQL service named `mysql`; inside the Sail network the
# host is the service name. Switch DB_CONNECTION to pgsql to use PostgreSQL.
###############################################################################
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=flights
DB_USERNAME=sail
DB_PASSWORD=password

###############################################################################
# Redis (queue + cache locks + Horizon)
#
# Sail provisions a Redis service named `redis`. Redis backs three things:
# the queue, the atomic cache locks used for idempotency, and Horizon state.
###############################################################################
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

###############################################################################
# Cache
#
# Default to Redis so Cache::lock() (used by the idempotency manager) has an
# atomic lock backend.
###############################################################################
CACHE_STORE=redis
CACHE_PREFIX=flights_cache_

###############################################################################
# Queue
#
# Default to Redis; update jobs are processed by Horizon. For a quick run
# without a worker you may set QUEUE_CONNECTION=sync to process inline.
###############################################################################
QUEUE_CONNECTION=redis

###############################################################################
# Horizon
###############################################################################
HORIZON_PREFIX=flights_horizon:
HORIZON_PATH=horizon

###############################################################################
# Sail / Docker
#
# Host ports mapped to the containers. Adjust if they clash with local services.
###############################################################################
APP_PORT=80
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
SAIL_XDEBUG_MODE=off

###############################################################################
# Session / Mail (Laravel defaults; not central to this API)
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
MAIL_MAILER=log
