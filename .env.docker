# Ready-made environment for the Docker Compose stack.
# Usage on a fresh clone:  cp .env.docker .env  &&  docker compose up --build
#
# Hosts point at the compose service names (mysql, redis), so this works inside
# the container network with no edits.

APP_NAME=FlightApi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Shared secret required in the `Api-Key` header. Change for any real use.
API_KEY=K7mP9xQ2vR8tL4nZ6bY3wF1sD5hA0cE

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database — host is the compose service name `mysql`.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=flights
DB_USERNAME=sail
DB_PASSWORD=password

# Redis — host is the compose service name `redis`.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Cache must be redis so the idempotency Cache::lock() has an atomic backend.
CACHE_STORE=redis
CACHE_PREFIX=flights_cache_

# Queue on redis; Horizon processes it.
QUEUE_CONNECTION=redis

HORIZON_PREFIX=flights_horizon:
HORIZON_PATH=horizon

# Host port mappings (left side of compose `ports`).
APP_PORT=80
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379

SESSION_DRIVER=database
SESSION_LIFETIME=120
MAIL_MAILER=log
